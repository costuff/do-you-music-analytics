# Database
DATABASE_URL=postgresql://doyou:changeme@localhost:5432/doyou_music
DB_MAX_CONNS=20
DB_TIMEOUT=10s

# Storage
#
# NAS_MUSIC_PATH: the HOST-SIDE path to your music directory.
#   Docker mounts this into the container at /mnt/music/downloads.
#   Change this per machine — each .env file is local and gitignored.
#
#   Mac Mini (production, external HDD):
#     NAS_MUSIC_PATH=/Volumes/Expansion/ExtHDD-8TB/Music
#   Local dev machine (NAS network-mounted):
#     NAS_MUSIC_PATH=/Volumes/NetworkDrive/Music
#
NAS_MUSIC_PATH=/Volumes/Expansion/ExtHDD-8TB/Music

# NAS_MOUNT_PATH: the path the app uses INSIDE the container (or locally when running without Docker).
#   When using Docker: always keep this as /mnt/music/downloads (matches the volume mount above).
#   When running locally without Docker: set this to the actual path on your machine.
NAS_MOUNT_PATH=/mnt/music/downloads

VALIDATE_NAS_ON_STARTUP=true    # Set to false on dev machines where NAS isn't always mounted

# Analysis
MAX_WORKERS=6                    # Number of parallel workers (6 optimal for M2 Mac)
PYTHON_PATH=/usr/bin/python3
ANALYSIS_SCRIPT=./scripts/analyze_audio.py
ANALYSIS_TIMEOUT=300s            # Per-track timeout (5 minutes)
MAX_ANALYSIS_ATTEMPTS=5          # Total attempts before a track is marked failed
RETRY_BASE_DELAY=30s             # Exponential retry backoff base (capped at 64x)
ANALYSIS_LEASE_TIMEOUT=10m       # Analyzing rows older than this are recovered at worker startup
SCAN_INTERVAL=30m                # Automatic NAS scan frequency (30 minutes)

# Cleanup (enabled by default)
ENABLE_CLEANUP=true              # Enable automatic cleanup of missing files
CLEANUP_ACTION=mark              # Action for missing files: "mark" or "delete"
CLEANUP_INTERVAL=10m             # How often to run cleanup (10 minutes)

# API
API_PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://raspberrypi.local

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
