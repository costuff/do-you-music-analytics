# Database
DATABASE_URL=postgresql://doyou:changeme@localhost:5432/doyou_music
DB_MAX_CONNS=20
DB_TIMEOUT=10s

# Storage
NAS_MOUNT_PATH=/mnt/music/downloads
VALIDATE_NAS_ON_STARTUP=true

# Analysis
MAX_WORKERS=6                    # Number of parallel workers (6 optimal for M2 Mac)
PYTHON_PATH=/usr/bin/python3
ANALYSIS_SCRIPT=./scripts/analyze_audio.py
ANALYSIS_TIMEOUT=300s            # Per-track timeout (5 minutes)
SCAN_INTERVAL=30m                # Automatic NAS scan frequency (30 minutes)

# Cleanup (enabled by default)
ENABLE_CLEANUP=true              # Enable automatic cleanup of missing files
CLEANUP_ACTION=mark              # Action for missing files: "mark" or "delete"
CLEANUP_INTERVAL=10m             # How often to run cleanup (10 minutes)

# API
API_PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://raspberrypi.local

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
