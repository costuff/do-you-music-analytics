# Environment Configuration for Mac Mini Production Deployment

# ============================================
# DATABASE CONFIGURATION
# ============================================
POSTGRES_USER=doyou
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD_HERE
POSTGRES_DB=doyou_music
POSTGRES_PORT=5432

# ============================================
# NAS / STORAGE PATHS
# ============================================
# CRITICAL: Update this path to match your actual NAS mount point
# Example Mac: /Volumes/Expansion/ExtHDD-8TB/Music/doyou-world-radio-tracks
# Example Linux: /mnt/nas/music/doyou-world-radio-tracks
NAS_MUSIC_PATH=/Volumes/Expansion/ExtHDD-8TB/Music/doyou-world-radio-tracks

# ============================================
# WORKER CONFIGURATION
# ============================================
# Number of tracks to process in each batch
BATCH_SIZE=10

# Number of parallel analyzer workers (recommend 2-8 based on CPU cores)
# Mac mini M1: 4-6 workers
# Mac mini Intel: 2-4 workers
MAX_WORKERS=4

# Maximum time to wait for analysis per track
ANALYSIS_TIMEOUT=90s

# ============================================
# API CONFIGURATION
# ============================================
API_PORT=8080

# ============================================
# LOGGING
# ============================================
# Options: debug, info, warn, error
LOG_LEVEL=info

# ============================================
# WATCHTOWER (AUTO-UPDATES)
# ============================================
# Optional: Get notifications when updates happen
# Uncomment and configure for Slack/Discord/etc
# WATCHTOWER_NOTIFICATIONS=slack
# WATCHTOWER_NOTIFICATION_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ============================================
# DOCKER REGISTRY AUTHENTICATION
# ============================================
# If using private GitHub Container Registry, authenticate with:
# echo $GITHUB_TOKEN | docker login ghcr.io -u YOUR_USERNAME --password-stdin
# This stores credentials in ~/.docker/config.json which is mounted by Watchtower
